# Maintainer: Emanueleparis98 <https://github.com/Emanueleparis98>
pkgname=termsport
pkgver=@VERSION@
pkgrel=1
pkgdesc='Search sports events and play live streams from the terminal'
arch=('any')
url='https://github.com/Emanueleparis98/termsport'
license=('MIT')
depends=('python>=3.11' 'python-textual>=8.2' 'python-httpx>=0.28' 'python-beautifulsoup4' 'python-platformdirs' 'streamlink>=8.6')
makedepends=('python-build' 'python-installer' 'python-hatchling')
optdepends=('mpv: video playback' 'vlc: alternative video player')
source=("https://github.com/Emanueleparis98/termsport/releases/download/v${pkgver}/termsport-${pkgver}.tar.gz")
sha256sums=('@SOURCE_SHA256@')

build() {
    cd "$srcdir/termsport-$pkgver"
    python -m build --wheel --no-isolation
}

package() {
    cd "$srcdir/termsport-$pkgver"
    python -m installer --destdir="$pkgdir" dist/*.whl
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
